# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# NOTA: en este repositorio, environments/<entorno>/*.tfvars es la configuracion versionada
# exigida por el Principio IV de la constitucion (Configuracion sobre Codigo) y NUNCA debe
# ignorarse: no contiene secretos, solo nombres, flags y referencias a secretos (secret_refs).
# Los valores reales de secretos jamas viven en un .tfvars; si alguna vez se necesitara un
# archivo verdaderamente local/sensible, usar uno de estos patrones explicitos en su lugar:
*.auto.tfvars
*.local.tfvars
secrets.tfvars
secrets.auto.tfvars

# Ignorar el estado local de uso unico de los bootstraps (deben migrar a estado remoto apenas
# exista, pero mientras tanto no debe commitearse)
bootstrap/**/*.tfstate
bootstrap/**/*.tfstate.backup

# Variables (incluye el Account Token de Railway y credenciales de Azure) para los
# bootstraps, en PowerShell: solo la plantilla "*.example" se commitea.
bootstrap/local.settings.ps1

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout